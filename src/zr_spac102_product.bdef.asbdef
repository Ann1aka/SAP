managed implementation in class zbp_r_spac102_product unique;
strict ( 2 );
with draft;

define behavior for ZR_SPAC102_PRODUCT //alias <alias_name>
persistent table zspac102_product
draft table zspac102_prdct_d
lock master total etag LastChangedAt

authorization master ( instance )
etag master LocalLastChangedAt
{


  //field ( readonly ) ProductId;

  field ( mandatory : create )
  ProductId;
  //ProductName,
  //ProductDescription;


  field ( readonly : update )
  ProductId;


  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  create ( authorization : global );
  update;
  delete;

    mapping for zspac102_product
    {
    ProductId = product_id;
    ProductName = product_name;
    ProductDescription = product_description;

    LocalCreatedBy = local_created_by;
    LocalCreatedAt = local_created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt = last_changed_at;
    }

}